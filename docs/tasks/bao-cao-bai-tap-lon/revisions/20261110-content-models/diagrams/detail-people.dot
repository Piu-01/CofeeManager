"people_0" -> "money" [label="Nguồn chi lương đã chốt",fontname="Times New Roman",fontsize="17",color="black",fontcolor="black",penwidth="1.2",arrowsize="0.9"];
"people_1" -> "hr" [label="Hồ sơ tài sản đã cập\nnhật",fontname="Times New Roman",fontsize="17",color="black",fontcolor="black",penwidth="1.2",arrowsize="0.9"];
"account" -> "people_0" [label="Tài khoản và quyền hiện\ncó",fontname="Times New Roman",fontsize="17",color="black",fontcolor="black",penwidth="1.2",arrowsize="0.9"];
"people_0" -> "account" [label="Tài khoản và quyền đã\ncập nhật",fontname="Times New Roman",fontsize="17",color="black",fontcolor="black",penwidth="1.2",arrowsize="0.9"];
"people_0" -> "people_2" [label="Kết quả nhân sự và\nlương",fontname="Times New Roman",fontsize="17",color="black",fontcolor="black",penwidth="1.2",arrowsize="0.9",weight="3"];
"people_1" -> "people_2" [label="Thông tin tài sản",fontname="Times New Roman",fontsize="17",color="black",fontcolor="black",penwidth="1.2",arrowsize="0.9",weight="3"];
"people_0" -> "people_1" [label="Yêu cầu quản lý tài sản\nđã kiểm quyền",fontname="Times New Roman",fontsize="17",color="black",fontcolor="black",penwidth="1.2",arrowsize="0.9",weight="3"];
