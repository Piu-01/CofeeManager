digraph G {
rankdir=LR; graph [bgcolor="white", pad="0.12", nodesep="0.35", ranksep="0.75", splines=polyline, overlap=false];
"money_0" [label="Ghi nhận thu chi thông\nthường",shape="box",fontname="Times New Roman",fontsize="20",color="black",fontcolor="black",penwidth="1.4",margin="0.10,0.08",style="rounded"];
"money_1" [label="Ghi chi và nợ từ phiếu\nnhập",shape="box",fontname="Times New Roman",fontsize="20",color="black",fontcolor="black",penwidth="1.4",margin="0.10,0.08",style="rounded"];
"money_2" [label="Ghi nhận trả nợ và tra\ncứu số dư",shape="box",fontname="Times New Roman",fontsize="20",color="black",fontcolor="black",penwidth="1.4",margin="0.10,0.08",style="rounded"];
"money_3" [label="Ghi chi lương theo\nbảng đã chốt",shape="box",fontname="Times New Roman",fontsize="20",color="black",fontcolor="black",penwidth="1.4",margin="0.10,0.08",style="rounded"];
"admin" [label="Người quản lý",shape="box",fontname="Times New Roman",fontsize="20",color="black",fontcolor="black",penwidth="1.4",margin="0.10,0.08"];
"store" [label="Nhân viên kho",shape="box",fontname="Times New Roman",fontsize="20",color="black",fontcolor="black",penwidth="1.4",margin="0.10,0.08"];
"catalog" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD BORDER="1" SIDES="TB" CELLPADDING="8">Danh mục nền</TD></TR></TABLE>>,shape="plain",fontname="Times New Roman",fontsize="20",color="black",fontcolor="black",penwidth="1.4",margin="0.10,0.08"];
"debt" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD BORDER="1" SIDES="TB" CELLPADDING="8">Hồ sơ công nợ</TD></TR></TABLE>>,shape="plain",fontname="Times New Roman",fontsize="20",color="black",fontcolor="black",penwidth="1.4",margin="0.10,0.08"];
"finance" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD BORDER="1" SIDES="TB" CELLPADDING="8">Chứng từ thu chi</TD></TR></TABLE>>,shape="plain",fontname="Times New Roman",fontsize="20",color="black",fontcolor="black",penwidth="1.4",margin="0.10,0.08"];
"inventory" [label="Quản lý kho",shape="box",fontname="Times New Roman",fontsize="20",color="black",fontcolor="black",penwidth="1.4",margin="0.10,0.08",style="rounded"];
"people" [label="Quản lý nhân sự, tài\nsản và báo cáo",shape="box",fontname="Times New Roman",fontsize="20",color="black",fontcolor="black",penwidth="1.4",margin="0.10,0.08",style="rounded"];
"admin" -> "money_0" [label="Yêu cầu thu chi hoặc\ntrả nợ",fontname="Times New Roman",fontsize="17",color="black",fontcolor="black",penwidth="1.2",arrowsize="0.9"];
"money_2" -> "admin" [label="Kết quả thu chi và trả\nnợ",fontname="Times New Roman",fontsize="17",color="black",fontcolor="black",penwidth="1.2",arrowsize="0.9"];
"store" -> "money_2" [label="Yêu cầu tra cứu công nợ",fontname="Times New Roman",fontsize="17",color="black",fontcolor="black",penwidth="1.2",arrowsize="0.9"];
"money_2" -> "store" [label="Số dư và lịch sử công\nnợ",fontname="Times New Roman",fontsize="17",color="black",fontcolor="black",penwidth="1.2",arrowsize="0.9"];
"catalog" -> "money_0" [label="Danh mục thu chi và\nphương thức trả",fontname="Times New Roman",fontsize="17",color="black",fontcolor="black",penwidth="1.2",arrowsize="0.9"];
"debt" -> "money_2" [label="Công nợ và lịch sử trả\nđã lưu",fontname="Times New Roman",fontsize="17",color="black",fontcolor="black",penwidth="1.2",arrowsize="0.9"];
"money_2" -> "debt" [label="Công nợ và lịch sử trả\nđã cập nhật",fontname="Times New Roman",fontsize="17",color="black",fontcolor="black",penwidth="1.2",arrowsize="0.9"];
"finance" -> "money_0" [label="Chứng từ thu chi đã lưu",fontname="Times New Roman",fontsize="17",color="black",fontcolor="black",penwidth="1.2",arrowsize="0.9"];
"money_0" -> "finance" [label="Chứng từ thu chi đã ghi",fontname="Times New Roman",fontsize="17",color="black",fontcolor="black",penwidth="1.2",arrowsize="0.9"];
"inventory" -> "money_1" [label="Nguồn phiếu nhập cần\nghi chi và nợ",fontname="Times New Roman",fontsize="17",color="black",fontcolor="black",penwidth="1.2",arrowsize="0.9"];
"money_1" -> "inventory" [label="Liên kết chi và nợ đã\ntạo",fontname="Times New Roman",fontsize="17",color="black",fontcolor="black",penwidth="1.2",arrowsize="0.9"];
"people" -> "money_3" [label="Nguồn chi lương đã chốt",fontname="Times New Roman",fontsize="17",color="black",fontcolor="black",penwidth="1.2",arrowsize="0.9"];
"money_3" -> "people" [label="Liên kết phiếu chi\nlương",fontname="Times New Roman",fontsize="17",color="black",fontcolor="black",penwidth="1.2",arrowsize="0.9"];
"money_1" -> "money_2" [label="Khoản nợ phát sinh từ\nnhập hàng",fontname="Times New Roman",fontsize="17",color="black",fontcolor="black",penwidth="1.2",arrowsize="0.9",weight="3"];
"money_1" -> "money_0" [label="Khoản trả ngay cần ghi\nchi",fontname="Times New Roman",fontsize="17",color="black",fontcolor="black",penwidth="1.2",arrowsize="0.9",weight="3"];
"money_2" -> "money_0" [label="Khoản trả nợ cần ghi\nchi",fontname="Times New Roman",fontsize="17",color="black",fontcolor="black",penwidth="1.2",arrowsize="0.9",weight="3"];
"money_3" -> "money_0" [label="Khoản chi lương cần ghi",fontname="Times New Roman",fontsize="17",color="black",fontcolor="black",penwidth="1.2",arrowsize="0.9",weight="3"];
{rank=same; money_0; money_1; money_2; money_3;}
{rank=min; admin; store;}
{rank=max; catalog; finance; debt;}
}