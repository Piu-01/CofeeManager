<ShowPlanXML xmlns="http://schemas.microsoft.com/sqlserver/2004/07/showplan" Version="1.599" Build="17.0.1000.7"><BatchSequence><Batch><Statements><StmtSimple StatementText="INSERT #rows(Code,Name,CountValue,Hours,Committed,Paid,Coverage,Quantity,Adjustment)&#xa;  SELECT n.MaNV,n.TenNV,COALESCE(c.Incomplete,0),COALESCE(c.Hours,0),COALESCE(b.Amount,0),COALESCE(p.Amount,0),CASE WHEN COALESCE(b.LegacyCount,0)&gt;0 THEN N&apos;Có bảng lương LegacyUnknown; giờ snapshot chỉ gồm New&apos; ELSE N&apos;Giờ snapshot chỉ gồm New&apos; END,COALESCE(b.RegularHours,0),COALESCE(b.OvertimeHours,0) FROM dbo.NHANVIEN n&#xa;  OUTER APPLY(SELECT SUM(CONVERT(decimal(38,4),CASE WHEN GioRa&gt;GioVao AND TrangThai=N&apos;Di lam&apos; THEN DATEDIFF_BIG(second,GioVao,GioRa) ELSE 0 END))/3600 Hours,SUM(CASE WHEN TrangThai=N&apos;Di lam&apos; AND (GioVao IS NULL OR GioRa IS NULL) THEN 1 ELSE 0 END) Incomplete FROM dbo.CHAMCONG WHERE MaNV=n.MaNV AND NgayLam&gt;=@From AND (@until IS NULL OR NgayLam&lt;@until)) c&#xa;  OUTER APPLY(SELECT SUM(CONVERT(decimal(38,0),ThucLinh)) Amount,SUM(CASE WHEN SnapshotKind=&apos;LegacyUnknown&apos; THEN 1 ELSE 0 END) LegacyCount,SUM(CASE WHEN SnapshotKind=&apos;New&apos; THEN CONVERT(decimal(28,4),RegularHours) ELSE 0 END) RegularHours,SUM(CASE WHEN SnapshotKind=&apos;New&apos; THEN CONVERT(decimal(28,4),OvertimeHours) ELSE 0 END) OvertimeHours FROM dbo.BANGLUONG WHERE MaNV=n.MaNV AND NgayChot&gt;=@From AND (@until IS NULL OR NgayChot&lt;@until)) b&#xa;  OUTER APPLY(SELECT SUM(CONVERT(decimal(38,0),p.SoTien)) Amount FROM dbo.BANGLUONG l JOIN dbo.PHIEUTHUCHI p ON p.MaBL=l.MaBL WHERE l.MaNV=n.MaNV AND p.NgayLap&gt;=@From AND (@until IS NULL OR p.NgayLap&lt;@until)) p&#xa;  WHERE (@Employee IS NULL OR n.MaNV=@Employee) AND (c.Hours IS NOT NULL OR b.Amount IS NOT NULL OR p.Amount IS NOT NULL)" StatementId="3" StatementCompId="41" StatementType="INSERT" StatementSqlHandle="0x09009588479E43DD0965F7DB1EFDBDA77EB40000000000000000000000000000000000000000000000000000" DatabaseContextSettingsId="1" ParentObjectId="1463676262" BatchSqlHandle="0x0300310066ED3D572C86C800FEB4000001000000000000000000000000000000000000000000000000000000" StatementParameterizationType="0" RetrievedFromCache="true" StatementSubTreeCost="0.0310629" StatementEstRows="3" SecurityPolicyApplied="false" StatementOptmLevel="FULL" QueryHash="0xE5D198408C1A0536" QueryPlanHash="0x401600254F73D164" StatementOptmEarlyAbortReason="GoodEnoughPlanFound" CardinalityEstimationModelVersion="170"><StatementSetOptions QUOTED_IDENTIFIER="true" ARITHABORT="false" CONCAT_NULL_YIELDS_NULL="true" ANSI_NULLS="true" ANSI_PADDING="true" ANSI_WARNINGS="true" NUMERIC_ROUNDABORT="false"></StatementSetOptions><QueryPlan DegreeOfParallelism="1" CachedPlanSize="184" CompileTime="73" CompileCPU="72" CompileMemory="2488"><MemoryGrantInfo SerialRequiredMemory="0" SerialDesiredMemory="0" GrantedMemory="0" MaxUsedMemory="0"></MemoryGrantInfo><OptimizerHardwareDependentProperties EstimatedAvailableMemoryGrant="137459" EstimatedPagesCached="103094" EstimatedAvailableDegreeOfParallelism="6" MaxCompileMemory="942048"></OptimizerHardwareDependentProperties><OptimizerStatsUsage><StatisticsInfo LastUpdate="2026-11-10T12:22:44.16" ModificationCount="0" SamplingPercent="100" Statistics="[_WA_Sys_0000000D_7A3223E8]" Table="[BANGLUONG]" Schema="[dbo]" Database="[CoffeeManager_Test_G07Bench_20261110_120959_21ead801]"></StatisticsInfo><StatisticsInfo LastUpdate="2026-11-10T12:10:27.38" ModificationCount="0" SamplingPercent="100" Statistics="[PK_BANGLUONG]" Table="[BANGLUONG]" Schema="[dbo]" Database="[CoffeeManager_Test_G07Bench_20261110_120959_21ead801]"></StatisticsInfo><StatisticsInfo LastUpdate="2026-11-10T12:10:27.39" ModificationCount="0" SamplingPercent="100" Statistics="[UQ_BL_Ky]" Table="[BANGLUONG]" Schema="[dbo]" Database="[CoffeeManager_Test_G07Bench_20261110_120959_21ead801]"></StatisticsInfo><StatisticsInfo LastUpdate="2026-11-10T12:10:26.98" ModificationCount="0" SamplingPercent="100" Statistic