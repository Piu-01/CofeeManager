<ShowPlanXML xmlns="http://schemas.microsoft.com/sqlserver/2004/07/showplan" Version="1.599" Build="17.0.1000.7"><BatchSequence><Batch><Statements><StmtSimple StatementText="INSERT #rows(Code,Name,CountValue,Inflow,Outflow,Amount)&#xa;  SELECT Code,Name,COUNT(*),SUM(Inflow),SUM(Outflow),SUM(Inflow)-SUM(Outflow) FROM(&#xa;   SELECT CONVERT(nvarchar(100),&apos;Sales&apos;) Code,CONVERT(nvarchar(200),N&apos;Thu bán hàng&apos;) Name,CONVERT(decimal(38,0),t.SoTien) Inflow,CONVERT(decimal(38,0),0) Outflow&#xa;   FROM dbo.HOADON h JOIN dbo.CHITIET_THANHTOAN t ON t.MaHD=h.MaHD WHERE h.TrangThai=N&apos;Da thanh toan&apos; AND h.NgayThanhToan&gt;=@From AND (@until IS NULL OR h.NgayThanhToan&lt;@until)&#xa;   UNION ALL&#xa;   SELECT CONVERT(nvarchar(100),p.OriginKind+&apos;:&apos;+d.Loai),CONVERT(nvarchar(200),p.OriginKind+N&apos; · &apos;+d.Loai),CASE WHEN d.Loai=N&apos;Thu&apos; THEN CONVERT(decimal(38,0),p.SoTien) ELSE 0 END,CASE WHEN d.Loai=N&apos;Chi&apos; THEN CONVERT(decimal(38,0),p.SoTien) ELSE 0 END&#xa;   FROM dbo.PHIEUTHUCHI p JOIN dbo.DANHMUC_THUCHI d ON d.MaDMTC=p.MaDMTC WHERE p.NgayLap&gt;=@From AND (@until IS NULL OR p.NgayLap&lt;@until)&#xa;  ) a GROUP BY Code,Name" StatementId="3" StatementCompId="36" StatementType="INSERT" StatementSqlHandle="0x09006FBCD548D8CB099667FF1FB1126FFD1B0000000000000000000000000000000000000000000000000000" DatabaseContextSettingsId="1" ParentObjectId="1463676262" BatchSqlHandle="0x0300310066ED3D572C86C800FEB4000001000000000000000000000000000000000000000000000000000000" StatementParameterizationType="0" RetrievedFromCache="true" StatementSubTreeCost="0.543022" StatementEstRows="1" SecurityPolicyApplied="false" StatementOptmLevel="FULL" QueryHash="0x5900DD032EA29EA9" QueryPlanHash="0x04B45206BEE977ED" StatementOptmEarlyAbortReason="TimeOut" CardinalityEstimationModelVersion="170"><StatementSetOptions QUOTED_IDENTIFIER="true" ARITHABORT="false" CONCAT_NULL_YIELDS_NULL="true" ANSI_NULLS="true" ANSI_PADDING="true" ANSI_WARNINGS="true" NU