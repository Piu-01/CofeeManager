    {
      "Id": "T18-K02 K03 paid next steps preserve all financial rows",
      "Sql": "EXEC dbo.G04New 'HD97000004',N'Giao hang'; EXEC dbo.G04Pay 'HD97000004';\nDECLARE @a int,@s binary(8),@r binary(8),@id uniqueidentifier=NEWID(),@seen bit=0; SELECT @a=MaTK,@s=SecurityStamp FROM dbo.TAIKHOAN WHERE MaNV='NV001'; SELECT @r=Revision FROM dbo.HOADON WHERE MaHD='HD97000004';\nBEGIN TRY EXEC dbo.sp_ChuyenTrangThaiGiaoHang @a,@s,'HD97000004',@r,N'Cho giao',N'Da giao',@id; END TRY BEGIN CATCH IF ERROR_NUMBER()<>52502 THROW; SET @seen=1; END CATCH; IF @seen=0 THROW 52990,'Skipped step',1;\nSET @id=NEWID(); EXEC dbo.sp_ChuyenTrangThaiGiaoHang @a,@s,'HD97000004',@r,N'Cho giao',N'Dang giao',@id; SELECT @r=Revision FROM dbo.HOADON WHERE MaHD='HD97000004'; SET @id=NEWID(); EXEC dbo.sp_ChuyenTrangThaiGiaoHang @a,@s,'HD97000004',@r,N'Dang giao',N'Da giao',@id;\nIF (SELECT COUNT(*) FROM dbo.CHITIET_THANHTOAN WHERE MaHD='HD97000004')<>1 THROW 52990,'Delivery duplicated finance',1;\n",
      "Status": "PASS"
    },
    {
      "Id": "T18-K04 open delivery cancellation no refund paid cancellation refused",
      "Sql": "EXEC dbo.G04New 'HD97000006',N'Giao hang';\nDECLARE @a int,@s binary(8),@r binary(8),@id uniqueidentifier=NEWID(); SELECT @a=MaTK,@s=SecurityStamp FROM dbo.TAIKHOAN WHERE MaNV='NV001'; SELECT @r=Revision FROM dbo.HOADON WHERE MaHD='HD97000006'; EXEC dbo.sp_HuyHoaDon @a,@s,'HD97000006',@r,@id;\nIF NOT EXISTS(SELECT 1 FROM dbo.HOADON WHERE MaHD='HD97000006' AND TrangThai=N'Huy' AND TrangThaiGiao=N'Huy giao') OR EXISTS(SELECT 1 FROM dbo.TIEUHAO_HOADON WHERE MaHD='HD97000006') THROW 52990,'Cancel delivery',1;\nSELECT @r=Revision FROM dbo.HOADON WHERE MaHD='HD97000004'; SET @id=NEWID(); DECLARE @seen bit=0; BEGIN TRY EXEC dbo.sp_HuyHoaDon @a,@s,'HD97000004',@r,@id; END TRY BEGIN CATCH IF ERROR_NUMBER()<>52102 THROW; SET @seen=1; END CATCH; IF @seen=0 THROW 52990,'Paid canceled',1;\n",
      "Status": "PASS"
    },
    {
